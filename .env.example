# ──────────────────────────────────────────────
# AutoMate web — environment reference
#
# Next.js reads env files from each app's own directory, so for LOCAL dev copy
# the relevant block into apps/web/<app>/.env.local.
# On Vercel, set these per project in Settings -> Environment Variables.
# ──────────────────────────────────────────────

# All three API modules are served by one backend process, namespaced by role.
# Local:      http://localhost:4000/api/<role>
# Production: https://<your-backend>.onrender.com/api/<role>
NEXT_PUBLIC_USER_API=http://localhost:4000/api/user
NEXT_PUBLIC_MECHANIC_API=http://localhost:4000/api/mechanic
NEXT_PUBLIC_ADMIN_API=http://localhost:4000/api/admin

# Landing page role hand-off — the deployed URL of each role app.
NEXT_PUBLIC_USER_APP_URL=http://localhost:3001
NEXT_PUBLIC_MECHANIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3003

# Where each role app's "Choose a different role" link points back to.
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# User app only — AI assistant, server-side only, never exposed to the browser.
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
